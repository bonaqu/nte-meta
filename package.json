{
  "name": "nte-meta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "playwright test",
    "test:ci": "playwright test tests/smoke.spec.ts tests/portal.spec.ts tests/api.spec.ts --grep \"renders starter app|главная показывает живой meta-dashboard без ошибок|отряды и ротации находятся внутри гайда, тир-лист единый|публичные коллекции доступны с безопасными заголовками\"",
    "test:full": "playwright test",
    "test:prepare-db": "node scripts/prepare-test-db.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nte-meta-db --local --env=\"\"",
    "db:migrate:remote": "wrangler d1 migrations apply nte-meta-db --remote --env=\"\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cloudflare/workers-types": "^4.20260602.1",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "wrangler": "^4.103.0"
  }
}
