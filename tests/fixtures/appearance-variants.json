        "title": "Неожиданная добыча I",
        "language": "Японский",
        "audioUrl": "/nte-meta/game-audio/8f0d0124fd4cf4dbb4e4.ogg",
        "sourceUrl": "",
        "description": "Спрячь это как следует."
